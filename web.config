<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="Python FastCGI" 
           path="*" 
           verb="*" 
           modules="FastCgiModule" 
           scriptProcessor="D:\vivek\personal_project_manager\venv\Scripts\python.exe|D:\vivek\personal_project_manager\venv\Lib\site-packages\wfastcgi.py" 
           resourceType="Unspecified" 
           requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
  <appSettings>
    <!-- WSGI Handler for Flask app -->
    <add key="WSGI_HANDLER" value="app.app" />
    <add key="PYTHONPATH" value="D:\vivek\personal_project_manager" />
    <add key="WSGI_LOG" value="D:\vivek\personal_project_manager\wfastcgi.log" />
  </appSettings>
</configuration>
